{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm *)", "Bash(npx *)", "Bash(node *)", "Bash(expo *)",
      "Bash(python3 *)", "Bash(pip3 *)", "Bash(uvicorn *)", "Bash(pytest *)",
      "Bash(ruff *)", "Bash(black *)", "Bash(supabase *)",
      "Bash(git status*)", "Bash(git add *)", "Bash(git commit *)",
      "Bash(git diff *)", "Bash(git log*)", "Bash(git branch*)",
      "Bash(git stash*)", "Bash(git restore *)"
    ],
    "ask": [
      "Bash(git push *)", "Bash(vercel *)", "Bash(railway *)",
      "Bash(supabase db push*)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.py\"" }
        ]
      }
    ]
  }
}