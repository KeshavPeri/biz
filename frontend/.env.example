# Frontend (Expo) environment — task 6.6
# Copy this file to `frontend/.env` and fill in the values. `.env` is gitignored;
# NEVER commit real keys. Expo inlines any EXPO_PUBLIC_* var into the client bundle
# at build time, so ONLY put values that are safe to be public here.

# Supabase project URL (public).
EXPO_PUBLIC_SUPABASE_URL=

# Supabase ANON key ONLY. It is public-safe because Row Level Security is the
# real lock (docs/api-architecture.md, two-key model). The service_role key
# bypasses RLS and is BACKEND-ONLY — it must NEVER appear in the frontend.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
